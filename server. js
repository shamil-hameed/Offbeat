const express = require('express');
const path = require('path');
const app = express();
const PORT = process.env.PORT || 3000;

// Middleware to parse incoming request data
app.use(express.json());

// Serve all static assets (CSS, JS, Fonts) directly from your assets folder
app.use('/assets', express.static(path.join(__dirname, 'assets')));

// Route to serve your main user interface layout
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, 'index.html'));
});

// Production Backend Authentication Engine
app.post('/api/login', (req, res) => {
    const { email, password } = req.body;

    // Secure validation matching your exact requested credentials
    if (email === 'admin@gmail.com' && password === 'adminpassword123') {
        return res.json({
            success: true,
            user: {
                email: 'admin@gmail.com',
                role: 'admin',
                token: 'mock-jwt-session-token-offfbeat'
            }
        });
    } else {
        return res.status(401).json({
            success: false,
            message: 'Invalid credentials. Access Denied.'
        });
    }
});

// Fallback catch-all to redirect broken routes back to the homepage
app.get('*', (req, res) => {
    res.redirect('/');
});

// Turn the engine on!
app.listen(PORT, () => {
    console.log(`==================================================`);
    console.log(`🚀 OFFFBEAT ENGINE RUNNING LIVE ON: http://localhost:${PORT}`);
    console.log(`==================================================`);
});
